{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Microsoft.EntityFrameworkCore.Migrations": "Information",
      "EasyPeasy": "Debug"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source={AppDataPath}/mukhalab.easypeasy.db;Cache=Shared",
    "SqliteConnection": "Data Source={AppDataPath}/mukhalab.easypeasy.db;Cache=Shared"
  },
  "Database": {
    "Provider": "SQLite",
    "AutoMigrate": true,
    "SeedInitialData": true,
    "CommandTimeoutMinutes": 5,
    "MaxRetryAttempts": 3,
    "RetryDelayMs": 1000,
    "EnableDetailedErrors": true,
    "EnableSensitiveDataLogging": false
  },
  "App": {
    "Name": "EasyPeasy",
    "Version": "1.0.0",
    "Environment": "Development"
  }
}